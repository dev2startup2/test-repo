# Airflow Core Configuration
AIRFLOW__CORE__DAGS_FOLDER=/home/user/test-repo/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/home/user/test-repo/plugins
AIRFLOW__CORE__BASE_LOG_FOLDER=/home/user/test-repo/logs
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=3
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16

# Database Configuration (Metadata DB)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow
AIRFLOW__DATABASE__LOAD_DEFAULT_CONNECTIONS=True

# Webserver Configuration
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_secret_key_for_production
AIRFLOW__WEBSERVER__WORKERS=4
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True

# Scheduler Configuration
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=300
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False
AIRFLOW__SCHEDULER__MAX_TIS_PER_QUERY=512

# Celery Configuration (agar CeleryExecutor ishlatilsa)
AIRFLOW__CELERY__BROKER_URL=redis://localhost:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@localhost:5432/airflow
AIRFLOW__CELERY__WORKER_CONCURRENCY=16

# Email Configuration
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@example.com
AIRFLOW__SMTP__SMTP_USER=your_email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_app_password

# Logging Configuration
AIRFLOW__LOGGING__BASE_LOG_FOLDER=/home/user/test-repo/logs
AIRFLOW__LOGGING__REMOTE_LOGGING=False
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Security
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW__WEBSERVER__RBAC=True

# Source Database Connections
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=source_db
SOURCE_DB_USER=source_user
SOURCE_DB_PASSWORD=source_password

# Target Database Connections
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=warehouse_db
TARGET_DB_USER=warehouse_user
TARGET_DB_PASSWORD=warehouse_password

# API Configuration
API_BASE_URL=https://api.example.com
API_KEY=your_api_key_here
API_TIMEOUT=30

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Cloud Storage (GCP)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCS_BUCKET_NAME=your-gcs-bucket

# Cloud Storage (Azure)
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_CONTAINER_NAME=your-container

# Monitoring
PROMETHEUS_PORT=9090
STATSD_HOST=localhost
STATSD_PORT=8125

# Application Settings
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
